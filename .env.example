# Vanilla Dream Radio — backend configuration example.
# Production values live in /etc/vanilla-dream-radio/env (never committed).

# Storage
VD_DB_PATH=/var/lib/vanilla-dream-radio/app.db
VD_MUSIC_DIR=/srv/vanilla-dream-radio/music
VD_COVER_DIR=/srv/vanilla-dream-radio/covers
VD_LOG_DIR=/var/log/vanilla-dream-radio

# Engine integration (localhost only)
VD_ENGINE_DIR=/run/vanilla-dream-radio
VD_ENGINE_QUEUE_FILE=/run/vanilla-dream-radio/engine-queue.txt
VD_ENGINE_SOCKET=/run/vanilla-dream-radio/liquidsoap.sock
VD_ENCODER_FILE=/etc/vanilla-dream-radio/encoder.liq
VD_STATION_FILE=/etc/vanilla-dream-radio/station.liq
VD_BACKEND_URL=http://127.0.0.1:8100
VD_INTERNAL_TOKEN=change-me-in-production

# Icecast statistics
VD_ICECAST_STATS_URL=http://127.0.0.1:8101/status-json.xsl
VD_ICECAST_ADMIN_USER=vdadmin
VD_ICECAST_ADMIN_PASSWORD=change-me-in-production

# Public facing
VD_PUBLIC_BASE_URL=https://vanilladream.duckdns.org
VD_SECURE_COOKIES=1
VD_FRONTEND_DIST=/opt/vanilla-dream-radio/frontend-dist

# Scheduler
VD_SCHEDULER_TICK=1.0
